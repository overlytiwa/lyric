{
  "manifest_version": 3,
  "name": "Lyric \u2014 Gemini Bridge",
  "version": "5.0.4",
  "minimum_chrome_version": "102",
  "key": "",
  "description": "Connect Lyric to a Gemini tab in your regular Chrome. No cookie or password access.",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Lyric",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
